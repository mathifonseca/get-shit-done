#!/usr/bin/env bash
set -euo pipefail

# GIT_OVERRIDE / NPM_OVERRIDE: optional test-injection seams (default to bare commands).
# Hooks remain production-equivalent when these are unset.
GIT_CMD="${GIT_OVERRIDE:-git}"
NPM_CMD="${NPM_OVERRIDE:-npm}"

# The hook gates on legacy SDK paths (sdk/src/...) that were retired in the
# 2026-06-10 upstream migration (open-gsd/gsd-core v1.4.x). The drift-check
# scripts that gated those paths (check:state-document-fresh,
# check:configuration-fresh, check:workstream-inventory-builder-fresh,
# check:project-root-fresh, check:plan-scan-fresh, check:secrets-fresh,
# check:schema-detect-fresh, check:decisions-fresh,
# check:workstream-name-policy-fresh) no longer exist in package.json.
#
# Only the alias-drift guard remains active — it gates against gsd-core's
# generated command-aliases.cjs going out of sync with the TypeScript
# source under src/. The other guards were removed because their generators
# / inputs were retired upstream along with the SDK; re-add a guard here
# only when a corresponding `check:*` npm script exists.

if "$GIT_CMD" diff --cached --name-only | grep -Eq "^src/command-aliases\.cts$|^gsd-core/bin/lib/command-aliases\.cjs$|^scripts/check-alias-drift\.cjs$"; then
  "$NPM_CMD" run check:alias-drift
fi
